---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  page: 'home' | 'docs' | '404' | 'changelog' | 'support' | 'privacy' | 'security' | 'press';
  lang: Lang;
}

const { lang, page } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'zh' : 'en';
const route = page === 'home' || page === '404' ? '' : page;
const otherHref = getRelativeLocaleUrl(other, route);
---

<footer class="border-t border-line py-7">
  <div class="wrap flex flex-wrap items-center gap-5">
    <div class="flex items-center gap-2 text-[0.82rem] font-semibold">
      <img src="/assets/icon-256.png" alt="" width="24" height="24" class="rounded-md" />
      <span>Remige</span>
    </div>
    <div class="ml-auto flex flex-wrap gap-5 text-xs">
      <a class="text-muted no-underline hover:text-ink" href={getRelativeLocaleUrl(lang, 'docs')}>{t.footer.docs}</a>
      <a class="text-muted no-underline hover:text-ink" href={getRelativeLocaleUrl(lang, 'changelog')}>{t.footer.changelog}</a>
      <a class="text-muted no-underline hover:text-ink" href={getRelativeLocaleUrl(lang, 'support')}>{t.footer.support}</a>
      <a class="text-muted no-underline hover:text-ink" href={getRelativeLocaleUrl(lang, 'privacy')}>{t.footer.privacy}</a>
      <a class="text-muted no-underline hover:text-ink" href={getRelativeLocaleUrl(lang, 'security')}>{t.footer.security}</a>
      <a class="text-muted no-underline hover:text-ink" href={getRelativeLocaleUrl(lang, 'press')}>{t.footer.press}</a>
      <a class="text-muted no-underline hover:text-ink" href="https://github.com/nichenqin/remige/releases">
        {t.footer.releases}
      </a>
      <a class="text-muted no-underline hover:text-ink" href="https://github.com/nichenqin/remige">
        {t.footer.github}
      </a>
      <a class="text-muted no-underline hover:text-ink" href="https://github.com/nichenqin/remige/blob/main/LICENSE">
        {t.footer.license}
      </a>
      <a class="text-muted no-underline hover:text-ink" href={otherHref}>
        {t.header.language}
      </a>
    </div>
    <div class="fine w-full">{t.footer.copyright}</div>
  </div>
</footer>
