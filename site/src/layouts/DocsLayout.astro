---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Frontmatter {
  lang: Lang;
  title?: string;
  description?: string;
  heading: string;
  lede: string;
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const { lang } = frontmatter;
const t = ui[lang];
const home = getRelativeLocaleUrl(lang);
---

<BaseLayout lang={lang} page="docs" title={frontmatter.title ?? t.meta.docsTitle} description={frontmatter.description ?? t.meta.docsDescription}>
  <article class="docs wrap">
    <a class="docs-back" href={home}>← {lang === 'zh' ? 'Remige 首页' : 'Remige home'}</a>
    <h1>{frontmatter.heading}</h1>
    <p class="lede mx-0! text-left!">{frontmatter.lede}</p>
    <slot />
    <p class="fine mt-14">
      MIT © 2026 nichenqin ·
      <a href="https://github.com/nichenqin/remige">GitHub</a> ·
      <a href={getRelativeLocaleUrl(lang, 'changelog')}>{lang === 'zh' ? '更新日志' : 'Changelog'}</a> ·
      <a href={getRelativeLocaleUrl(lang, 'support')}>{lang === 'zh' ? '支持' : 'Support'}</a> ·
      <a href={getRelativeLocaleUrl(lang, 'privacy')}>{lang === 'zh' ? '隐私' : 'Privacy'}</a> ·
      <a href={getRelativeLocaleUrl(lang, 'security')}>{lang === 'zh' ? '安全' : 'Security'}</a>
    </p>
  </article>
</BaseLayout>
