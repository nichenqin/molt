---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: 'changelog' | 'support' | 'privacy' | 'security' | 'press';
  title: string;
  description: string;
  heading: string;
  lede: string;
}

const { lang, page, title, description, heading, lede } = Astro.props;
const home = getRelativeLocaleUrl(lang);
---

<BaseLayout lang={lang} page={page} title={title} description={description}>
  <article class="docs wrap">
    <a class="docs-back" href={home}>← {lang === 'zh' ? 'Remige 首页' : 'Remige home'}</a>
    <h1>{heading}</h1>
    <p class="lede mx-0! text-left!">{lede}</p>
    <slot />
  </article>
</BaseLayout>
