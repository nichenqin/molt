{
  "$schema": "./site/node_modules/wrangler/config-schema.json",
  "name": "remige-site",
  "compatibility_date": "2026-10-19",
  "main": "./edge/site-worker.js",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "remige.app", "custom_domain": true },
    { "pattern": "www.remige.app", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
